# Connection settings for scripts/plgrid/remote.sh. Copy this file to .env in the repository root (it is
# gitignored) and fill it in. The keys are the same as in the AL_System project, so its .env can be reused:
#
#     PLG_ENV_FILE=../AL_System/.env bash scripts/plgrid/remote.sh sync
#
# Only PLG_* and MPN_AL_* keys are read; the file is never executed. Values in the environment win.
PLG_HOST=athena.cyfronet.pl
PLG_LOGIN=plgXXXXXXX
# Private key. Optional when an SSH agent holds the key (jobs are non-interactive: a key with a passphrase
# must be in the agent). Git Bash notation on Windows: /c/Users/you/.ssh/plgrid_key
PLG_IDENTITY_FILE=
# Grant and partition used for jobs (as in AL_System).
PLG_GRANT=plgaktywneuczenie-gpu-a100
PLG_PARTITION=plgrid-gpu-a100
# Optional, passed on to the cluster, e.g. a PyTorch build for an older GPU driver:
# MPN_AL_TORCH_INDEX=https://download.pytorch.org/whl/cu128
